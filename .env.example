# Cloudflare Worker URL (3단계에서 생성한 Worker URL)
VITE_API_URL=https://notion-diary-proxy.YOUR_SUBDOMAIN.workers.dev


# ============================================
# Cloudflare Worker 환경변수 (참고용 - Cloudflare Dashboard에서 설정)
# ============================================

# NOTION_API_KEY=secret_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# NOTION_DATABASE_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# ALLOWED_ORIGIN=https://davidclimbing.github.io
